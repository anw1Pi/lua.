..(" false then false else string.format(\"%s/autoload.txt\", CurrentS"
.."ettingsPath)\nend\n\nfunction SaveManager:SetLoadingOrder(Enabled: "
.."boolean, Order: {string}?)\n    SaveManager.UseLoadingOrder = Ena"
.."bled == true\n    SaveManager.LoadingOrder = typeof(Order) == \"ta"
