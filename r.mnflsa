..("SetAlwaysOnTop(Enabled: boolean)\n        WindowInfo.AlwaysOnTop "
.."= Enabled == true\n        SetAlwaysOnTop(Library.ScreenGui, Wind"
.."owInfo.AlwaysOnTop)\n    end\n\n    function Window:SetSnapping(Ena"
.."bled: boolean, Distance: number?, Margin: number?, AvoidCoreGui:"
.." boolean?)\n        WindowInfo.Snapping = Enabled == true\n       "
.." WindowSnapConfig.Enabled = WindowInfo.Snapping\n\n        if Dist"
.."ance then\n            WindowInfo.SnapDistance = math.max(0, Dist"
.."ance)\n            WindowSnapConfig.Distance = WindowInfo.SnapDis"
