.." boolean?\n    )\n        ElementParser[ElementType] = { \n        "
.."    Save = function(Index: string, Element: any, ...)\n          "
.."      local Data = Save(Index, Element, ...)\n                Dat"
.."a.type = ElementType\n                Data.idx = Index\n\n         "
.."       return Data\n            end, \n\n            Load = functio"
