.."           local AbsX = FramePos.X.Scale * ViewportSize.X + NewX"
.."\n                local AbsY = FramePos.Y.Scale * ViewportSize.Y "
.."+ NewY\n\n                local ElemSize = UI.AbsoluteSize\n       "
.."         local TargetsX, TargetsY = GetSnapEdges(ElemSize, Viewp"
.."ortSize, Margin, SnapConfig.AvoidCoreGui ~= false)\n             "
.."   local SnappedX, SnappedXName = GetClosestSnapTarget(AbsX, Tar"
.."getsX, Distance)\n                local SnappedY, SnappedYName = "
.."GetClosestSnapTarget(AbsY, TargetsY, Distance)\n\n                "
.."if SnappedX then\n                    NewX = SnappedX - FramePos."
