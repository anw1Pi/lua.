.."00)\n    local Start = StartPos and Vector2.new(StartPos.X.Offset"
..", StartPos.Y.Offset) or Vector2.new(6, 6)\n    local Padding = 6\n"
.."\n    local CurrentX = Start.X\n    local CurrentY = Start.Y\n\n    "
