.."150, 40) end\n\n    local MaxXInColumn = Size.X\n\n    while true do"
.."\n        local Obstacle = GetOverlappingDraggable(UI, Vector2.ne"
.."w(CurrentX, CurrentY))\n        if not Obstacle then\n            "
.."break\n        end\n\n        if Obstacle.AbsoluteSize.X > MaxXInCo"
.."lumn then\n            MaxXInColumn = Obstacle.AbsoluteSize.X\n   "
.."     end\n\n        local NextY = Obstacle.AbsolutePosition.Y + Ob"
.."stacle.AbsoluteSize.Y + Padding\n        if NextY + Size.Y > Scre"
.."enSize.Y - Padding then\n            local NextX = CurrentX + Max"
.."XInColumn + Padding\n\n            if NextX + Size.X > ScreenSize."
.."X - Padding then\n                break\n            end\n\n        ")
..("    CurrentY = Start.Y\n            CurrentX = NextX\n            "
.."MaxXInColumn = Size.X\n        else\n            CurrentY = NextY\n"
.."        end\n    end\n\n    return UDim2.fromOffset(CurrentX, Curre"
.."ntY)\nend\n\nfunction PositionDraggable(UI: GuiObject, StartPos: UD"
.."im2?)\n    UI.Position = GetNonOverlappingPosition(UI, StartPos)\n"
.."end\n\nlocal function GetCoreGuiInset(): (Vector2, Vector2)\n    lo"
