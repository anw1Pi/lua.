.."if not IsCompact then\n            LastExpandedWidth = Width\n    "
.."    end\n    end\n\n    function Window:ShowTabInfo(Name, Descripti"
.."on)\n        CurrentTabLabel.Text = Name\n        CurrentTabDescri"
.."ption.Text = Description\n\n        if IsDefaultSearchbarSize then"
.."\n            SearchBox.Size = UDim2.fromScale(0.5, 1)\n        en"
