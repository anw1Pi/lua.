local function curTab() return Spec.Tabs[Sel.tab] end

local function curHost()
	local t = curTab()
	return t and t.Hosts[Sel.host]
end

local function clampSel()
	Sel.tab = math.clamp(Sel.tab, 1, math.max(#Spec.Tabs, 1))
	local t = curTab()
	Sel.host = math.clamp(Sel.host, 1, math.max(t and #t.Hosts or 0, 1))
end

local function eachSlot(fn)
	for ti, tab in ipairs(Spec.Tabs) do
		for hi, host in ipairs(tab.Hosts) do
			for _, c in ipairs(host.Containers) do
				for _, s in ipairs(contSlots(c)) do
					if fn(s, c, host, tab, ti, hi) then return end
				end
			end
		end
	end
end

local function findHostOf(container)
	for _, tab in ipairs(Spec.Tabs) do
		for _, host in ipairs(tab.Hosts) do
			for _, c in ipairs(host.Containers) do
				if c == container then return host, tab end
			end
		end
	end
end

local function inMain(obj)
	local mf = Main.Lib and Main.Lib.MainFrame
	if not mf then return true end
	local p, sz = rectOf(obj)
	local mp, ms = rectOf(mf)
	local cx, cy = p.X + sz.X / 2, p.Y + sz.Y / 2
	return cx >= mp.X and cx <= mp.X + ms.X and cy >= mp.Y and cy <= mp.Y + ms.Y
end

local function hostShown(h)
	local hc = containerOf(h.live)
	if hc and hc.Parent and isShown(hc) and inMain(hc) then return true end
	for _, c in ipairs(h.Containers) do
		local cc = containerOf(c.live)
		if cc and cc.Parent and isShown(cc) and inMain(cc) then return true end
	end
	return false
end

local function visibleHost(m)
	local lib = Main.Lib
	local act = lib and lib.ActiveTab
	local tab
	if act then
		for _, t in ipairs(Spec.Tabs) do
			if t.live == act then
				tab = t
				break
			end
		end
	end
	tab = tab or curTab()
	if not tab then return nil, nil end
	local host
	if tab.SubTabs then
		for _, h in ipairs(tab.Hosts) do
			if hostShown(h) then
				host = h
				break
			end
		end
		if not host and tab == curTab() then host = curHost() end
		if not host then host = tab.Hosts[1] end
	else
		host = tab.Hosts[1]
	end
	Sel.tab = indexOf(Spec.Tabs, tab) or Sel.tab
	if host then Sel.host = indexOf(tab.Hosts, host) or Sel.host end
	return tab, host
end

local function slotRegion(slot)
	local cont = containerOf(slot.live)
	if not cont or not cont.Parent or not isShown(cont) then return nil end
	local p, s = rectOf(cont)
	return p.X - 8, p.Y - 34, s.X + 16, s.Y + 44
end

local function slotAt(m, onlyGroupbox)
	local best, area
	eachSlot(function(s, c)
		if onlyGroupbox and s ~= c then return end
		local x, y, w, h = slotRegion(s)
		if x and m.X >= x and m.X <= x + w and m.Y >= y and m.Y <= y + h then
			local a = w * h
			if not area or a < area then best, area = s, a end
		end
	end)
	return best
end

local function insertPoint(slot, my)
	local idx = 1
	for i, e in ipairs(slot.Elements) do
		local p, s = unionRect(e.holders)
		if p then
			if my > p.Y + s.Y * 0.5 then idx = i + 1 end
		else
			idx = i + 1
		end
	end
	local cont = containerOf(slot.live)
	local cp, cs = rectOf(cont)
	local y = cp.Y
	local prev = slot.Elements[idx - 1]
	local pp, ps = unionRect(prev and prev.holders)
	if pp then y = pp.Y + ps.Y end
	return idx, y, cp.X, cs.X
end

local function slotInside(e, slot)
	for _, cs in ipairs(childSlots(e)) do
		if cs == slot then return true end
		for _, x in ipairs(cs.Elements) do
			if slotInside(x, slot) then return true end
		end
	end
	return false
end

local function elementAt(m)
	local found, slot, area
	eachSlot(function(s)
		for _, e in ipairs(s.Elements) do
			local p, sz = unionRect(e.holders)
			if p and m.X >= p.X and m.X <= p.X + sz.X and m.Y >= p.Y and m.Y <= p.Y + sz.Y then
				local a = sz.X * sz.Y
				if not area or a < area then found, slot, area = e, s, a end
			end
		end
	end)
	return found, slot
end

