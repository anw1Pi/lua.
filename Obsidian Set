local function refreshPropTabs()
	PropEntries = {}
	local list = {}
	for ti, tab in ipairs(Spec.Tabs) do
		local key = ("%d  %s"):format(ti, tab.Name)
		list[#list + 1] = key
		PropEntries[key] = { kind = "tab", tab = tab }
		if tab.SubTabs then
			for hi, host in ipairs(tab.Hosts) do
				local k2 = ("%d.%d  %s > %s"):format(ti, hi, tab.Name, host.Name or ("SubTab " .. hi))
				list[#list + 1] = k2
				PropEntries[k2] = { kind = "host", tab = tab, host = host }
			end
		end
	end
	if #list == 0 then list = { "-" } end
	local current = BO.PropTabSel and BO.PropTabSel.Value
	local found = false
	for _, v in ipairs(list) do if v == current then found = true end end
	if not found then
		current = list[1]
		local S = Selected
		if S then
			for key, en in pairs(PropEntries) do
				if (en.kind == "tab" and S.obj == en.tab) or (en.kind == "host" and S.obj == en.host) then
					current = key
				end
			end
		end
	end
	guarded(function()
		BO.PropTabSel:SetValues(list)
		BO.PropTabSel:SetValue(current)
	end)
end

BO.PropTabSel:OnChanged(function()
	if Guard > 0 then return end
	local en = PropEntries[BO.PropTabSel.Value]
	if not en then return end
	if en.kind == "tab" then
		Selected = { kind = "tab", obj = en.tab }
		Sel.tab = indexOf(Spec.Tabs, en.tab) or Sel.tab
	else
		Selected = { kind = "host", obj = en.host, tab = en.tab }
		Sel.tab = indexOf(Spec.Tabs, en.tab) or Sel.tab
		Sel.host = indexOf(en.tab.Hosts, en.host) or Sel.host
	end
	loadProps()
end)

local rbToken = 0

loadProps = function()
	refreshStatus()
end

local function restoreView()
	local t = curTab()
	if t and t.live then pcall(function() t.live:Show() end) end
	local h = curHost()
	if t and t.SubTabs and h and h.live then pcall(function() h.live:Show() end) end
end

commit = function(reload, noHistory)
	rbToken = rbToken + 1
	if not noHistory then
		table.insert(UndoStack, lastSnap)
		if #UndoStack > 150 then table.remove(UndoStack, 1) end
		RedoStack = {}
	end
	if Selected and Selected.kind == "element" and Selected.obj.type == "Tabbox" then
		syncTabs(Selected.obj)
	end
	lastSnap = deepCopy(Spec.Tabs)
	visibleHost(nil)
	clampSel()
	rebuild()
	refreshPropTabs()
	refreshCopyList()
	restoreView()
	if reload ~= false then loadProps() end
	refreshStatus()
end

undo = function()
	if #UndoStack == 0 then return BNotify("History", "Nothing to undo") end
	table.insert(RedoStack, deepCopy(Spec.Tabs))
	Spec.Tabs = table.remove(UndoStack)
	lastSnap = deepCopy(Spec.Tabs)
	Selected = nil
	rbToken = rbToken + 1
	clampSel()
	rebuild()
	refreshPropTabs()
	refreshCopyList()
	restoreView()
	loadProps()
end

redo = function()
	if #RedoStack == 0 then return BNotify("History", "Nothing to redo") end
	table.insert(UndoStack, deepCopy(Spec.Tabs))
	Spec.Tabs = table.remove(RedoStack)
	lastSnap = deepCopy(Spec.Tabs)
	Selected = nil
	rbToken = rbToken + 1
	clampSel()
	rebuild()
	refreshPropTabs()
	refreshCopyList()
	restoreView()
	loadProps()
end

local function selectElementAt(m)
	local e, slot = elementAt(m)
	if not e then return false end
	local ti, hi
	eachSlot(function(s, c, h, t)
		if s == slot then
			ti = indexOf(Spec.Tabs, t)
			hi = indexOf(t.Hosts, h)
			return true
		end
	end)
	if ti then Sel.tab = ti end
	if hi then Sel.host = hi end
	selectElementObj(e, slot)
	return true
end

local function selectGroupAt(m)
	local best, area
	eachSlot(function(s, c)
		local isMain = (c.Kind == "Groupbox" and s == c) or (c.Kind == "Tabbox" and indexOf(c.Tabs, s))
		if isMain then
			local x, y, w, h = slotRegion(s)
			if x and m.X >= x and m.X <= x + w and m.Y >= y and m.Y <= y + h then
				local a = w * h
				if not area or a < area then best, area = { c, s }, a end
			end
		end
	end)
	if best then
		local c, s = best[1], best[2]
		if c.Kind == "Groupbox" then
			Selected = { kind = "groupbox", obj = c, container = c, slot = c }
		else
			Selected = { kind = "tabboxslot", obj = s, container = c, slot = s }
		end
		return true
	end
	return false
end

