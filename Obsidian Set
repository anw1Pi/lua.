local function findRoot(title)
	local c = RootCache[title]
	if c and c.Parent then return c end
	local places = { game:GetService("CoreGui"), Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") }
	pcall(function() if gethui then table.insert(places, gethui()) end end)
	for _, place in ipairs(places) do
		if place then
			for _, gui in ipairs(place:GetChildren()) do
				if gui:IsA("ScreenGui") and gui ~= DragGui then
					for _, d in ipairs(gui:GetDescendants()) do
						if d:IsA("TextLabel") and d.Text == title then
							RootCache[title] = gui
							return gui
						end
					end
				end
			end
		end
	end
end

local function rootOf(lib, title)
	if lib and lib.ScreenGui and lib.ScreenGui.Parent then return lib.ScreenGui end
	return findRoot(title)
end

local function overWindow(lib, title, m)
	local root = rootOf(lib, title)
	if not root then return false end
	local vp = workspace.CurrentCamera.ViewportSize
	for _, ch in ipairs(root:GetChildren()) do
		if ch:IsA("GuiObject") and ch.Visible then
			local s = ch.AbsoluteSize
			if s.X > 200 and s.Y > 150 and s.X < vp.X * 0.9 and inRect(ch, m) then return true end
		end
	end
	return false
end

local function headerLabel(title)
	local cached = HeaderCache[title]
	if cached and cached.l and cached.l.Parent then return cached.l end
	if cached and not cached.l and os.clock() - cached.t < 2 then return nil end
	local root = rootOf(LibB, PANEL_TITLE)
	local found
	if root then
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text == title then
				found = d
				break
			end
		end
	end
	HeaderCache[title] = { l = found, t = os.clock() }
	return found
end

