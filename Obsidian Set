local function stripPanelChrome()
	if Stripped then return true end
	local root = LibB.ScreenGui
	if not root then return false end
	local win, wa = nil, 0
	for _, ch in ipairs(root:GetChildren()) do
		if ch:IsA("GuiObject") then
			local a = ch.AbsoluteSize.X * ch.AbsoluteSize.Y
			if a > wa then win, wa = ch, a end
		end
	end
	if not win or wa <= 0 then return false end
	local W, Hh = win.AbsoluteSize.X, win.AbsoluteSize.Y

	local sidebar
	for _, d in ipairs(win:GetDescendants()) do
		if d:IsA("TextLabel") and d.Text == PANEL_TAB then
			local a = d
			while a and a ~= win do
				if a:IsA("GuiObject") and a.AbsoluteSize.Y > Hh * 0.5 and a.AbsoluteSize.X < W * 0.5 and a.AbsoluteSize.X > 30 then
					sidebar = a
				end
				a = a.Parent
			end
			if sidebar then break end
		end
	end
	if not sidebar then return false end
	sidebar.Visible = false

	if not Widened and sidebar.Parent then
		for _, sib in ipairs(sidebar.Parent:GetChildren()) do
			if sib ~= sidebar and sib:IsA("GuiObject") and sib.AbsoluteSize.Y > Hh * 0.5
				and sib.AbsolutePosition.X >= sidebar.AbsolutePosition.X + sidebar.AbsoluteSize.X - 2 then
				sib.Position = UDim2.new(sidebar.Position.X.Scale, sidebar.Position.X.Offset, sib.Position.Y.Scale, sib.Position.Y.Offset)
				sib.Size = UDim2.new(
					sib.Size.X.Scale + sidebar.Size.X.Scale, sib.Size.X.Offset + sidebar.Size.X.Offset,
					sib.Size.Y.Scale, sib.Size.Y.Offset
				)
				ContentFrame = sib
				Widened = true
				break
			end
		end
	end

	local footerFound = false
	for _, d in ipairs(win:GetDescendants()) do
		if d:IsA("TextLabel") and d.Text == FOOTER_MARK then
			footerFound = true
			local bar = d.Parent
			local a = d
			while a and a ~= win do
				if a:IsA("GuiObject") and a.AbsoluteSize.X > W * 0.9 and a.AbsoluteSize.Y < 40 then
					bar = a
					break
				end
				a = a.Parent
			end
			local barH = 0
			if bar and bar:IsA("GuiObject") then
				barH = bar.AbsoluteSize.Y
				bar.Visible = false
			end
			d.Visible = false
			if ContentFrame and not FooterAdjusted then
				FooterAdjusted = true
				ContentFrame.Size = UDim2.new(
					ContentFrame.Size.X.Scale, ContentFrame.Size.X.Offset,
					ContentFrame.Size.Y.Scale, ContentFrame.Size.Y.Offset + barH
				)
			end
			break
		end
	end

	if footerFound then Stripped = true end
	return Stripped
end

