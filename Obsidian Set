local function q(s)
	return string.format("%q", tostring(s))
end

local function nz(s)
	if s == nil or s == "" then return nil end
	return s
end

local function split(str)
	local t = {}
	for part in tostring(str or ""):gmatch("[^,]+") do
		part = part:gsub("^%s+", ""):gsub("%s+$", "")
		if part ~= "" then t[#t + 1] = part end
	end
	return t
end

local function splitAll(str)
	local t = {}
	for part in ((str or "") .. ","):gmatch("([^,]*),") do
		part = part:gsub("^%s+", ""):gsub("%s+$", "")
		t[#t + 1] = part
	end
	return t
end

local function sanitizeIdx(s, fallback)
	s = tostring(s or ""):gsub("[^%w_]", "")
	if s == "" then return fallback end
	return s
end

local function rgbOf(s)
	local p = split(s)
	return tonumber(p[1]) or 255, tonumber(p[2]) or 255, tonumber(p[3]) or 255
end

local function numFromValue(v)
	return tonumber(tostring(v):match("^(%d+)"))
end

local function deepCopy(t)
	if type(t) ~= "table" then return t end
	local n = {}
	for k, v in pairs(t) do
		if k ~= "live" and k ~= "_label" and k ~= "holders" then n[k] = deepCopy(v) end
	end
	return n
end

local function removeFrom(list, obj)
	for i, v in ipairs(list) do
		if v == obj then
			table.remove(list, i)
			return true
		end
	end
	return false
end

local function indexOf(list, obj)
	for i, v in ipairs(list) do
		if v == obj then return i end
	end
	return nil
end

local function guarded(fn)
	Guard = Guard + 1
	pcall(fn)
	Guard = Guard - 1
end

local function BNotify(title, desc)
	pcall(function() LibB:Notify({ Title = title, Description = tostring(desc), Time = 3 }) end)
end

local function insetOf(obj)
	local sg = obj and obj:FindFirstAncestorOfClass("ScreenGui")
	if sg and sg.IgnoreGuiInset then return Vector2.new(0, 0) end
	return GuiService:GetGuiInset()
end

local function rectOf(obj)
	return obj.AbsolutePosition + insetOf(obj), obj.AbsoluteSize
end

local function inRect(obj, m)
	local p, s = rectOf(obj)
	return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
end

local function isShown(obj)
	local cur = obj
	while cur and cur ~= game do
		if cur:IsA("GuiObject") and not cur.Visible then return false end
		if cur:IsA("ScreenGui") and not cur.Enabled then return false end
		cur = cur.Parent
	end
	return obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0
end

local function safeParent(gui)
	local ok = pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
	if not ok or not gui.Parent then gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end
end

local function unionRect(list)
	local minX, minY, maxX, maxY
	for _, h in ipairs(list or {}) do
		if h.Parent and isShown(h) then
			local p, s = rectOf(h)
			minX = math.min(minX or p.X, p.X)
			minY = math.min(minY or p.Y, p.Y)
			maxX = math.max(maxX or (p.X + s.X), p.X + s.X)
			maxY = math.max(maxY or (p.Y + s.Y), p.Y + s.Y)
		end
	end
	if not minX then return nil end
	return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

local function drawRect(frame, pos, size, pad)
	frame.Position = UDim2.fromOffset(pos.X - pad, pos.Y - pad)
	frame.Size = UDim2.fromOffset(size.X + pad * 2, size.Y + pad * 2)
	frame.Visible = true
end

