local function moveSelected(dir)
	local S = Selected
	if not S then return end
	if S.kind == "element" then
		local list = S.slot.Elements
		local i = indexOf(list, S.obj)
		if i and list[i + dir] then
			list[i], list[i + dir] = list[i + dir], list[i]
			commit(true)
		end
	elseif S.kind == "groupbox" or S.kind == "tabboxslot" then
		local host = selHostContainer()
		if not host then return end
		local i = indexOf(host.Containers, S.container)
		if i and host.Containers[i + dir] then
			host.Containers[i], host.Containers[i + dir] = host.Containers[i + dir], host.Containers[i]
			commit(true)
		end
	elseif S.kind == "tab" then
		local i = indexOf(Spec.Tabs, S.obj)
		if i and Spec.Tabs[i + dir] then
			Spec.Tabs[i], Spec.Tabs[i + dir] = Spec.Tabs[i + dir], Spec.Tabs[i]
			Sel.tab = i + dir
			commit(true)
		end
	elseif S.kind == "host" then
		local tab = S.tab
		local i = indexOf(tab.Hosts, S.obj)
		if i and tab.Hosts[i + dir] then
			tab.Hosts[i], tab.Hosts[i + dir] = tab.Hosts[i + dir], tab.Hosts[i]
			commit(true)
		end
	end
end

local function deleteSelected()
	local S = Selected
	if not S then return end
	if S.kind == "element" then
		removeFrom(S.slot.Elements, S.obj)
	elseif S.kind == "groupbox" then
		local host = selHostContainer()
		if host then removeFrom(host.Containers, S.obj) end
	elseif S.kind == "tabboxslot" then
		local c = S.container
		removeFrom(c.Tabs, S.obj)
		if #c.Tabs == 0 then
			local host = findHostOf(c)
			if host then removeFrom(host.Containers, c) end
		end
	elseif S.kind == "host" then
		if #S.tab.Hosts <= 1 then
			return BNotify("Error", "A tab with SubTabs needs at least one SubTab")
		end
		removeFrom(S.tab.Hosts, S.obj)
	elseif S.kind == "tab" then
		removeFrom(Spec.Tabs, S.obj)
	end
	Selected = nil
	commit(true)
end

