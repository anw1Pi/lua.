		if not t then
			t = { Elements = {} }
			e.Tabs[i] = t
		end
		t.Name = n
		t.Icon = icons[i] or ""
		t.MaxHeight = ""
	end
	for i = #e.Tabs, #names + 1, -1 do table.remove(e.Tabs, i) end
end

local function newElement(kind)
	Counter = Counter + 1
	local e = { type = kind }
	for _, f in ipairs(ELEM_FIELDS) do e[f.key] = f.default end
	for k, v in pairs(TEMPLATES[kind] or {}) do e[k] = v end
	local card = CARD_BY_KIND[kind]
	if card then
		for k, v in pairs(readFields("D_" .. kind .. "_", card.fields)) do e[k] = v end
	end
	e.idx = ("El%d"):format(Counter)
	return e
end

local function selectElementObj(e, slot)
	local container
	eachSlot(function(s, c)
		if s == slot then
			container = c
			return true
		end
	end)
	Selected = { kind = "element", obj = e, slot = slot, container = container }
end

local function addElementAt(slot, e, idx)
	idx = math.clamp(idx or (#slot.Elements + 1), 1, #slot.Elements + 1)
	table.insert(slot.Elements, idx, e)
	selectElementObj(e, slot)
	commit(false)
	loadProps()
end

local function addTabFromDefaults()
	local d = readFields("D_Tab_", TAB_CARD)
	local tab = {
		Name = nz(d.Name) or ("Tab " .. (#Spec.Tabs + 1)),
		Desc = d.Desc, Icon = d.Icon,
		SubTabs = d.SubTabs == true, Hosts = {},
	}
	if not tab.SubTabs then tab.Hosts[1] = { Containers = {} } end
	table.insert(Spec.Tabs, tab)
	Sel.tab, Sel.host = #Spec.Tabs, 1
	Selected = { kind = "tab", obj = tab }
	commit(true)
end

local function addSubTabFromDefaults(m)
	local tab = visibleHost(m)
	if not tab then return BNotify("Error", "Add a tab first") end
	local d = readFields("D_SubTab_", SUB_CARD)
	if not tab.SubTabs then
		tab.SubTabs = true
		tab.form = nil
		for i, h in ipairs(tab.Hosts) do
			h.Name = h.Name or (i == 1 and "Main" or ("SubTab " .. i))
		end
	end
	local host = { Name = nz(d.Name) or ("SubTab " .. (#tab.Hosts + 1)), Icon = d.Icon, Containers = {} }
	table.insert(tab.Hosts, host)
	Sel.tab = indexOf(Spec.Tabs, tab) or Sel.tab
	Sel.host = #tab.Hosts
	Selected = { kind = "host", obj = host, tab = tab }
	commit(true)
end

local function sideFor(m, fallback)
	local minX, maxX
	eachSlot(function(s)
		local cont = containerOf(s.live)
		if cont and cont.Parent and isShown(cont) then
			local p, sz = rectOf(cont)
			minX = math.min(minX or p.X, p.X)
			maxX = math.max(maxX or (p.X + sz.X), p.X + sz.X)
		end
	end)
	if minX and maxX and maxX - minX > 50 then
		return m.X > (minX + maxX) / 2 and "Right" or "Left"
	end
	return fallback
end

local function addGroupboxFromDefaults(m)
	local _, host = visibleHost(m)
	if not host then return BNotify("Error", "Add a tab or subtab first") end
	local d = readFields("D_Groupbox_", GROUP_FIELDS)
	local c = {
		Kind = "Groupbox", Name = nz(d.Name) or "Groupbox", Desc = d.Desc, Icon = d.Icon,
		Side = sideFor(m, d.Side), MaxHeight = d.MaxHeight,
		Collapsed = d.Collapsed, DisableCollapsing = d.DisableCollapsing, Elements = {},
	}
	table.insert(host.Containers, c)
	Selected = { kind = "groupbox", obj = c, container = c, slot = c }
	commit(true)
end

local function addTabboxToHost(m)
	local _, host = visibleHost(m)
	if not host then return BNotify("Error", "Add a tab or subtab first") end
	local d = readFields("D_Tabbox_", TABBOX_CARD)
	local first = { Name = nz(d.TabName) or "Tab 1", Icon = d.TabIcon, MaxHeight = "", Elements = {} }
	local c = {
		Kind = "Tabbox", Side = sideFor(m, d.Side), MaxHeight = d.MaxHeight, Tabs = { first },
	}
	table.insert(host.Containers, c)
	Selected = { kind = "tabboxslot", obj = first, container = c, slot = first }
	commit(true)
end

local function addNestedTabbox(slot, idx)
	local d = readFields("D_Tabbox_", TABBOX_CARD)
	Counter = Counter + 1
	local e = {
		type = "Tabbox", idx = ("El%d"):format(Counter),
		tabNames = (nz(d.TabName) or "Tab 1") .. ", Tab 2",
		tabIcons = nz(d.TabIcon) or "",
	}
	syncTabs(e)
	addElementAt(slot, e, idx)
end

local function groupboxAt(m)
	local found
	eachSlot(function(s, c)
		if s == c and s.Kind == "Groupbox" then
			local x, y, w, h = slotRegion(s)
			if x and m.X >= x and m.X <= x + w and m.Y >= y and m.Y <= y + h then
				found = s
			end
		end
	end)
	return found
end

local function placeKind(kind, m, target)
	if kind == "Tab" then
		if not overWindow(Main.Lib, MAIN_TITLE, m) then return end
		return addTabFromDefaults()
	end
	if kind == "SubTab" then
		if not overWindow(Main.Lib, MAIN_TITLE, m) then return end
		return addSubTabFromDefaults(m)
	end
	if kind == "Groupbox" then
		if not overWindow(Main.Lib, MAIN_TITLE, m) then return end
		return addGroupboxFromDefaults(m)
	end
	if kind == "Tabbox" then
		local gb = (target and target.slot and target.slot.Kind == "Groupbox") and target.slot or groupboxAt(m)
		if gb then
			return addNestedTabbox(gb, target and target.idx or nil)
		end
		if not overWindow(Main.Lib, MAIN_TITLE, m) then return end
		return addTabboxToHost(m)
	end
	local slot = (target and target.slot) or slotAt(m)
	if not slot then return BNotify("Error", "Drop inside a groupbox") end
	local idx = (target and target.idx) or insertPoint(slot, m.Y)
	local e = newElement(kind)
	addElementAt(slot, e, idx)
end

