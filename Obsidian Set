local DRAG_DIST = 8
local Pending, Drag = nil, nil

local function setDragLock(on)
	pcall(function() if Main.Lib then Main.Lib.CantDragForced = on end end)
	pcall(function() LibB.CantDragForced = on end)
end

local function previewDrag(m)
	Drag.target = nil
	Ind.Visible = false
	HlDrop.Visible = false
	local kind = Drag.kind
	if Drag.src == "move" then
		local slot = slotAt(m)
		if slot and not slotInside(Drag.element, slot) then
			Drag.target = { slot = slot, idx = insertPoint(slot, m.Y) }
			showSlotTarget(slot, m)
		end
	elseif IS_ELEMENT[kind] then
		local slot = slotAt(m)
		if slot then
			Drag.target = { slot = slot, idx = insertPoint(slot, m.Y) }
			showSlotTarget(slot, m)
		end
	elseif kind == "Tabbox" then
		local slot = slotAt(m)
		if slot and slot.Kind == "Groupbox" then
			Drag.target = { slot = slot, idx = insertPoint(slot, m.Y) }
			showSlotTarget(slot, m)
		elseif overWindow(Main.Lib, MAIN_TITLE, m) then
			Drag.target = {}
		end
	elseif overWindow(Main.Lib, MAIN_TITLE, m) then
		Drag.target = {}
	end
	Ghost.BackgroundColor3 = Drag.target and ACCENT or Color3.fromRGB(150, 70, 70)
end

local function finishPointer(m)
	local d, p = Drag, Pending
	Pending, Drag = nil, nil
	Ghost.Visible = false
	Ind.Visible = false
	HlDrop.Visible = false
	Sink.Visible = false
	setDragLock(false)
	if d then
		if not d.target then return end
		if d.src == "move" then
			local from, e, to = d.slot, d.element, d.target
			local idx = to.idx
			if to.slot == from then
				local fi = indexOf(from.Elements, e)
				if fi and fi < idx then idx = idx - 1 end
			end
			removeFrom(from.Elements, e)
			table.insert(to.slot.Elements, math.clamp(idx, 1, #to.slot.Elements + 1), e)
			selectElementObj(e, to.slot)
			commit(true)
		else
			placeKind(d.kind, m, d.target)
		end
	elseif p then
		if p.src == "move" then
			selectElementObj(p.element, p.slot)
			loadProps()
		elseif p.src == "palette" then
			Armed = p.kind
			refreshStatus()
		else
			if Armed then
				placeArmed(m)
			elseif selectElementAt(m) or selectGroupAt(m) then
				loadProps()
			end
		end
	end
end

Conns[#Conns + 1] = RunService.RenderStepped:Connect(function()
	if Closing then return end
	local p, s = selectionRect()
	if p then drawRect(HlSel, p, s, 2) else HlSel.Visible = false end
	local m = UIS:GetMouseLocation()
	if Drag then
		Ghost.Position = UDim2.fromOffset(m.X + 12, m.Y + 12)
		previewDrag(m)
		return
	end
	if Armed and IS_ELEMENT[Armed] and overWindow(Main.Lib, MAIN_TITLE, m) then
		local slot = slotAt(m)
		if slot then
			showSlotTarget(slot, m)
			return
		end
	end
	Ind.Visible = false
	HlDrop.Visible = false
end)

Conns[#Conns + 1] = UIS.InputBegan:Connect(function(i)
	if Closing then return end
	local t = i.UserInputType
	if t == Enum.UserInputType.MouseButton2 then
		local m = UIS:GetMouseLocation()
		local card = cardAt(m)
		if card then
			Pending = { src = "palette", kind = card.kind, start = m }
			return
		end
		local e, slot = elementAt(m)
		if e then
			Pending = { src = "move", kind = e.type, element = e, slot = slot, start = m }
			return
		end
		Pending = { src = "place", start = m }
	elseif t == Enum.UserInputType.Keyboard then
		if i.KeyCode == Enum.KeyCode.Escape then
			Armed = nil
			refreshStatus()
		elseif UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			if i.KeyCode == Enum.KeyCode.Z then
				undo()
			elseif i.KeyCode == Enum.KeyCode.Y then
				redo()
			end
		end
	end
end)

Conns[#Conns + 1] = UIS.InputChanged:Connect(function(i)
	if Closing or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
	if Pending and Pending.src ~= "place" and not Drag and (UIS:GetMouseLocation() - Pending.start).Magnitude > DRAG_DIST then
		Drag = { src = Pending.src, kind = Pending.kind, element = Pending.element, slot = Pending.slot }
		Ghost.Text = (Drag.src == "move" and "Move: " or "Add: ") .. tostring(Drag.kind)
		Ghost.Visible = true
		Sink.Visible = Drag.src == "move"
		setDragLock(true)
	end
