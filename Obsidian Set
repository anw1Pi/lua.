local function T(fields, depth)
	depth = depth or 1
	local ind = ("\t"):rep(depth)
	local lines = {}
	for _, f in ipairs(fields) do
		if f[2] ~= nil then lines[#lines + 1] = ind .. f[1] .. " = " .. f[2] .. "," end
	end
	return "{\n" .. table.concat(lines, "\n") .. "\n" .. ("\t"):rep(depth - 1) .. "}"
end

local function addonColor(idx, title, e)
	local r, g, b = rgbOf(e.colorDefault)
	return ("AddColorPicker(%s, %s)"):format(q(idx), T({
		{ "Default", ("Color3.fromRGB(%d, %d, %d)"):format(r, g, b) },
		{ "Title", q(title) },
		{ "Callback", CALLBACK },
	}, 2))
end

local function addonKey(idx, title, e)
	return ("AddKeyPicker(%s, %s)"):format(q(idx), T({
		{ "Default", q(nz(e.keyDefault) or "X") },
		{ "Mode", q(nz(e.keyMode) or "Toggle") },
		{ "Text", q(title) },
		{ "NoUI", "false" },
		{ "Callback", CALLBACK },
	}, 2))
end

local function dropdownValues(e)
	local out, first, set = {}, nil, {}
	for _, v in ipairs(split(e.values)) do
		local title = v:match("^%-%-%-(.*)$")
		if title then
			out[#out + 1] = ("Library:DropdownDivider(%s)"):format(q(title))
		else
			out[#out + 1] = q(v)
			first = first or v
			set[v] = true
		end
	end
	if #out == 0 then
		out = { q("Option1"), q("Option2") }
		first = "Option1"
		set["Option1"] = true
	end
	local def = (nz(e.default) and set[e.default]) and e.default or first
	return out, def
end

local SETTINGS_OK = { Toggle = true, Checkbox = true, Slider = true, Input = true, Dropdown = true }

local function baseElement(var, e)
	local t, idx = e.type, sanitizeIdx(e.idx, "El")
	local text = (e.text and e.text ~= "") and e.text or t
	local tip = nz(e.tooltip) and q(e.tooltip) or nil
	local risky = e.risky and "true" or nil
	local dis = e.disabled and "true" or nil
	local s

	if t == "Divider" then
		s = nz(e.text) and ("%s:AddDivider(%s)"):format(var, q(e.text)) or (var .. ":AddDivider()")

	elseif t == "Label" then
		local wrap = not (e.addColor or e.addKey)
		s = ("%s:AddLabel(%s%s)"):format(var, q(text), wrap and ", true" or "")

	elseif t == "Toggle" or t == "Checkbox" then
		s = ("%s:Add%s(%s, %s)"):format(var, t, q(idx), T({
			{ "Text", q(text) }, { "Tooltip", tip },
			{ "Default", e.default == "true" and "true" or "false" },
			{ "Risky", risky }, { "Disabled", dis }, { "Callback", CALLBACK },
		}))

	elseif t == "Button" then
		s = ("%s:AddButton(%s)"):format(var, T({
			{ "Text", q(text) },
			{ "Func", "function() end" },
			{ "Tooltip", tip }, { "Risky", risky }, { "Disabled", dis },
		}))
		if nz(e.subText) then
			s = s .. ("\n\t:AddButton({ Text = %s, Func = function() end })"):format(q(e.subText))
		end

	elseif t == "Slider" then
		local mn, mx = tonumber(e.min) or 0, tonumber(e.max) or 100
		s = ("%s:AddSlider(%s, %s)"):format(var, q(idx), T({
			{ "Text", q(text) }, { "Default", tostring(tonumber(e.default) or mn) },
			{ "Min", tostring(mn) }, { "Max", tostring(mx) },
			{ "Rounding", tostring(tonumber(e.rounding) or 0) },
			{ "Suffix", nz(e.suffix) and q(e.suffix) or nil },
			{ "Compact", e.compact and "true" or nil },
			{ "Tooltip", tip }, { "Disabled", dis }, { "Callback", CALLBACK },
		}))

	elseif t == "Input" then
		s = ("%s:AddInput(%s, %s)"):format(var, q(idx), T({
			{ "Text", q(text) }, { "Default", q(e.default or "") },
			{ "Placeholder", nz(e.placeholder) and q(e.placeholder) or nil },
			{ "Numeric", e.numeric and "true" or nil },
			{ "Finished", e.finished and "true" or nil },
			{ "Tooltip", tip }, { "Callback", CALLBACK },
		}))

	elseif t == "Dropdown" then
		local vals, def = dropdownValues(e)
		s = ("%s:AddDropdown(%s, %s)"):format(var, q(idx), T({
			{ "Text", q(text) },
			{ "Values", "{ " .. table.concat(vals, ", ") .. " }" },
			{ "Default", q(def) },
			{ "Multi", e.multi and "true" or "false" },
			{ "Searchable", e.searchable and "true" or "false" },
			{ "AutoWidth", e.autoWidth and "true" or nil },
			{ "Tooltip", tip }, { "Disabled", dis }, { "Callback", CALLBACK },
		}))

	elseif t == "ColorPicker" then
		s = ("%s:AddLabel(%s)\n\t:%s"):format(var, q(text), addonColor(idx, text, e))

	elseif t == "KeyPicker" then
		s = ("%s:AddLabel(%s)\n\t:%s"):format(var, q(text), addonKey(idx, text, e))

	elseif t == "Image" then
		s = ("%s:AddImage(%s, %s)"):format(var, q(idx), T({
			{ "Image", q(e.image or "") },
			{ "Height", tostring(tonumber(e.height) or 150) },
		}))

	elseif t == "Viewport" then
		local obj = nz(e.objectPath)
		local objExpr = obj or '(function() local p = Instance.new("Part") p.Size = Vector3.new(4, 4, 4) p.Anchored = true return p end)()'
		s = ("%s:AddViewport(%s, %s)"):format(var, q(idx), T({
			{ "Object", objExpr },
			{ "Clone", obj and "true" or nil },
			{ "Interactive", e.interactive and "true" or "false" },
			{ "AutoFocus", "true" },
			{ "Height", tostring(tonumber(e.height) or 150) },
		}))

	else
		return "local _ = nil"
	end

	if t == "Toggle" or t == "Checkbox" or t == "Label" then
		if e.addColor then s = s .. "\n\t:" .. addonColor(idx .. "_Color", text, e) end
		if e.addKey then s = s .. "\n\t:" .. addonKey(idx .. "_Key", text, e) end
	end
	return s
end

local function elementCode(var, e, sv)
	local code = baseElement(var, e)
	if nz(e.icon) and e.type ~= "Image" and e.type ~= "Viewport" then
		code = ("do\n\tlocal before = Snapshot(%s)\n%s\n\tApplyIcon(%s, before, %s)\nend")
			:format(var, code, var, q(e.icon))
	end
	local hasSv = false
	if e.settings and e.sset and SETTINGS_OK[e.type] then
		local reg = (e.type == "Toggle" or e.type == "Checkbox") and "Toggles" or "Options"
		code = code .. ("\nlocal %s = %s[%s]:AddSettings({ Width = %d })")
			:format(sv, reg, q(sanitizeIdx(e.idx, "El")), tonumber(e.gearWidth) or 220)
		hasSv = true
	end
	return code, hasSv
end

local function lineAddTab(tab, tv)
	local name, icon, desc = tab.Name, nz(tab.Icon), nz(tab.Desc)
	if tab.form == "table" then
		return ("local %s = Window:AddTab(%s)"):format(tv, T({
			{ "Name", q(name) },
			{ "Icon", icon and q(icon) or nil },
			{ "Description", desc and q(desc) or nil },
			{ "SubTabs", tab.SubTabs and "true" or nil },
		}))
	end
	local args = { q(name), icon and q(icon) or "nil", desc and q(desc) or "nil" }
	if tab.SubTabs then args[4] = "true" end
	while #args > 1 and args[#args] == "nil" do args[#args] = nil end
	return ("local %s = Window:AddTab(%s)"):format(tv, table.concat(args, ", "))
end

local function lineSubTab(tv, hv, host)
	if nz(host.Icon) then
		return ("local %s = %s:AddSubTab(%s, %s)"):format(hv, tv, q(host.Name or "SubTab"), q(host.Icon))
	end
	return ("local %s = %s:AddSubTab(%s)"):format(hv, tv, q(host.Name or "SubTab"))
end

local function maxHeightLine(v, mh)
	local n = tonumber(mh)
	if n and n > 0 then
		return ("\nif %s.SetMaxHeight then %s:SetMaxHeight(%d) end"):format(v, v, n)
	end
	return ""
end

local function lineGroupbox(pv, v, c)
	local mh = tonumber(c.MaxHeight)
	return ("local %s = %s:AddGroupbox(%s)"):format(v, pv, T({
		{ "Side", q(c.Side) },
		{ "Name", q(c.Name) },
		{ "Description", nz(c.Desc) and q(c.Desc) or nil },
		{ "IconName", nz(c.Icon) and q(c.Icon) or nil },
		{ "MaxHeight", (mh and mh > 0) and tostring(mh) or nil },
		{ "Collapsed", c.Collapsed and "true" or nil },
		{ "DisableCollapsing", c.DisableCollapsing and "true" or nil },
	}))
end

local function lineTabbox(pv, v, c)
	return ("local %s = %s:Add%sTabbox()"):format(v, pv, c.Side) .. maxHeightLine(v, c.MaxHeight)
end

local function lineTabboxTab(bv, v, t)
	local icon = nz(t.Icon) and (", " .. q(t.Icon)) or ""
	return ("local %s = %s:AddTab(%s%s)"):format(v, bv, q(t.Name), icon) .. maxHeightLine(v, t.MaxHeight)
end

local function childSlots(e)
	local list = {}
	if e.settings and e.sset then list[#list + 1] = e.sset end
	if e.type == "Tabbox" and e.Tabs then
		for _, t in ipairs(e.Tabs) do list[#list + 1] = t end
	end
	return list
end

local function contSlots(c)
	local list = {}
	if not c then return list end
	local function addChildren(slot, label)
		for _, e in ipairs(slot.Elements) do
			for _, cs in ipairs(childSlots(e)) do
				if e.type == "Tabbox" then
					cs._label = label .. " > Tab: " .. tostring(cs.Name)
				else
					cs._label = label .. " > Gear: " .. (e.text ~= "" and e.text or e.idx)
				end
				list[#list + 1] = cs
				addChildren(cs, cs._label)
			end
		end
	end
	if c.Kind == "Groupbox" then
		c._label = "Groupbox: " .. c.Name
		list[1] = c
		addChildren(c, c._label)
	else
		for _, t in ipairs(c.Tabs) do
			t._label = "Tab: " .. t.Name
			list[#list + 1] = t
			addChildren(t, t._label)
		end
	end
	return list
end

local function genElements(var, elements, w)
	for i, e in ipairs(elements) do
		local sv = ("%s_%d"):format(var, i)
		if e.type == "Tabbox" then
			w(("local %s = %s:AddTabbox()"):format(sv, var))
			for ti, t in ipairs(e.Tabs or {}) do
				local tv = ("%s_%d"):format(sv, ti)
				w(lineTabboxTab(sv, tv, t))
				genElements(tv, t.Elements, w)
			end
		else
			local code, hasSv = elementCode(var, e, sv)
			w(code)
			if hasSv then genElements(sv, e.sset.Elements, w) end
		end
	end
end

local function genContainer(hv, cv, c, w)
	w("")
	if c.Kind == "Groupbox" then
		w(lineGroupbox(hv, cv, c))
		genElements(cv, c.Elements, w)
	else
		w(lineTabbox(hv, cv, c))
		for ti, t in ipairs(c.Tabs) do
			local tv = ("%s_%d"):format(cv, ti)
			w(lineTabboxTab(cv, tv, t))
			genElements(tv, t.Elements, w)
		end
	end
end

local function walkTab(tab, fn)
	for _, h in ipairs(tab.Hosts) do
		for _, c in ipairs(h.Containers) do
			for _, s in ipairs(contSlots(c)) do
				for _, e in ipairs(s.Elements) do fn(e) end
			end
		end
	end
end

local function generate(only, header)
	local out = {}
	local function w(s) out[#out + 1] = s end
	local picked = {}
	for i, t in ipairs(Spec.Tabs) do
		if not only or only == i then picked[#picked + 1] = { i, t } end
	end

	if header then
		w('local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"')
		w('local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()')
		w("local Options = Library.Options")
		w("local Toggles = Library.Toggles")
		w("")
		w('local Window = Library:CreateWindow({ Title = "Window", Footer = "Generated", Center = true, AutoShow = true })')
		w("")
	end

	local needIcons = false
	for _, it in ipairs(picked) do
		walkTab(it[2], function(e) if nz(e.icon) then needIcons = true end end)
	end
	if needIcons then w(ICON_HELPERS) end

	for _, it in ipairs(picked) do
		local ti, tab = it[1], it[2]
		local tv = "Tab" .. ti
		w(lineAddTab(tab, tv))
		for hi, host in ipairs(tab.Hosts) do
			local hv = tv
			if tab.SubTabs then
				hv = ("%sS%d"):format(tv, hi)
				w(lineSubTab(tv, hv, host))
			end
			for ci, c in ipairs(host.Containers) do
				genContainer(hv, ("%sC%d"):format(hv, ci), c, w)
			end
		end
		w("")
	end
	return table.concat(out, "\n")
end

local function containerOf(live)
	return live and (live.Container or live.Holder)
end

local function exec(code, vars)
	vars = vars or {}
	vars.Library = Main.Lib
	vars.Options = Main.Lib.Options
	vars.Toggles = Main.Lib.Toggles
	vars.Window = Main.Win
	local names, vals = {}, {}
	for k, v in pairs(vars) do
		names[#names + 1] = k
		vals[#vals + 1] = v
	end
	local src = "local " .. table.concat(names, ", ") .. " = ...\n"
		.. (code:find("Snapshot%(") and ICON_HELPERS or "") .. code
	local fn, err = loadstring(src)
	if not fn then return false, err end
	return pcall(fn, table.unpack(vals, 1, #names))
end

local liveAddElement
local liveBuildTabboxTab

local function liveBuildElements(slot)
	for _, e in ipairs(slot.Elements) do
		liveAddElement(slot, e)
	end
end

liveAddElement = function(slot, e)
	if not slot.live then return false end
	local cont = containerOf(slot.live)
	local before = {}
	if cont then
		for _, v in ipairs(cont:GetChildren()) do before[v] = true end
	end
	local function collect()
		e.holders = {}
		if cont then
			for _, v in ipairs(cont:GetChildren()) do
				if not before[v] and v:IsA("GuiObject") then e.holders[#e.holders + 1] = v end
			end
		end
	end

	if e.type == "Tabbox" then
		local ok, res = exec("return Group:AddTabbox()", { Group = slot.live })
		if not ok or not res then
			BNotify("Tabbox error", res)
			return false
		end
		e.live = res
		collect()
		for _, t in ipairs(e.Tabs or {}) do liveBuildTabboxTab(e, t) end
		return true
	end

	local code, hasSv = elementCode("Group", e, "Sv")
	if hasSv then code = code .. "\nreturn Sv" end
	local ok, res = exec(code, { Group = slot.live })
	if not ok then
		BNotify("Element error (" .. e.type .. ")", res)
		return false
	end
	collect()
	if hasSv then
		e.sset.live = res
		if res then liveBuildElements(e.sset) end
	end
	return true
end

liveBuildTabboxTab = function(c, t)
	local ok, res = exec(lineTabboxTab("Box", "Tb", t) .. "\nreturn Tb", { Box = c.live })
	if not ok or not res then
		BNotify("Tabbox tab error", res)
		return false
	end
	t.live = res
	liveBuildElements(t)
	return true
end

local function liveBuildContainer(host, c)
	if not host.live then return false end
	if c.Kind == "Groupbox" then
		local ok, res = exec(lineGroupbox("Host", "G", c) .. "\nreturn G", { Host = host.live })
		if not ok or not res then
			BNotify("Groupbox error", res)
			return false
		end
		c.live = res
		liveBuildElements(c)
	else
		local ok, res = exec(lineTabbox("Host", "B", c) .. "\nreturn B", { Host = host.live })
		if not ok or not res then
			BNotify("Tabbox error", res)
			return false
		end
		c.live = res
		for _, t in ipairs(c.Tabs) do liveBuildTabboxTab(c, t) end
	end
	return true
end

local function tryTab(tab)
	local forms = tab.form and { tab.form } or (tab.SubTabs and { "table", "pos" } or { "pos" })
	for _, f in ipairs(forms) do
		tab.form = f
		local ok, res = exec(lineAddTab(tab, "Tab") .. "\nreturn Tab", {})
		if ok and res and (not tab.SubTabs or (type(res) == "table" and res.AddSubTab)) then
			tab.live = res
			return true
		end
		tab.live = nil
	end
	tab.form = nil
	return false
end

local function buildSpecTabs()
	for _, tab in ipairs(Spec.Tabs) do
		if not tryTab(tab) then
			BNotify("Tab error", tab.Name .. " could not be created")
		else
			for _, host in ipairs(tab.Hosts) do
				if tab.SubTabs then
					local ok, res = exec(lineSubTab("Tab", "Sub", host) .. "\nreturn Sub", { Tab = tab.live })
					host.live = ok and res or nil
					if not ok then BNotify("SubTab error", res) end
				else
					host.live = tab.live
				end
				if host.live then
					for _, c in ipairs(host.Containers) do liveBuildContainer(host, c) end
				end
			end
		end
	end
end

